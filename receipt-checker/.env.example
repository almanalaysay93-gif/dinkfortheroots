# Copy this file to .env and fill in the values. Do not share the .env file.

# Apps Script web app URL. It ends with /exec.
ENDPOINT=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec

# Admin key. Must equal the ADMIN_KEY script property in Apps Script.
ADMIN_KEY=REPLACE_WITH_ADMIN_KEY

# Amount in pesos that each player pays.
EXPECTED_AMOUNT=1200

# Optional. A name or number fragment that must appear in the recipient of the receipt.
# Leave empty to skip the recipient check.
EXPECTED_RECIPIENT=DIANA ROSE IBANEZ

# Earliest allowed receipt date, YYYY-MM-DD.
EVENT_WINDOW_START=2026-10-01
